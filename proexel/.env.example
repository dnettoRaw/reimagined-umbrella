APPCORE_APPLICATION_MANIFEST=proexel/apps/service/application.toml
APPCORE_DEPLOYMENT_MANIFEST=proexel/apps/service/deployment.local.toml

# Used by apps/web API routes when the AppCore service is running.
PROEXEL_SERVICE_URL=http://127.0.0.1:39400
PROEXEL_SERVICE_TOKEN=
# Map JSON capability -> token. It takes precedence over the generic token.
PROEXEL_SERVICE_TOKENS={}
# Server-only authentication. Generate a random secret with at least 32 chars.
PROEXEL_SESSION_SECRET=
# First-bootstrap seed only: [{"id":"...","email":"...","name":"...","role":"admin","password_hash":"scrypt$salt$hex"}]
PROEXEL_AUTH_USERS=[]
# Protected photo/signature file store used by the Next.js server.
PROEXEL_ATTACHMENTS_DIR=proexel/apps/service/target/runtime/attachments
